    <xsd:complexType name="sezione_soggetti_coinvolti_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Soggetti coinvolti</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="soggetti_coinvolti" type="esogcoi:soggetti_coinvolti_ctype" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="obblighi_salute_sicurezza" type="eoblsalsicaltpdc:obblighi_salute_sicurezza_soggetti_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Rispetto degli obblighi in materia di salute e sicurezza nei luoghi di lavoro</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="sezione_pat_soggetti_coinvolti" type="ssogcoi:sezione_soggetti_coinvolti_ctype"/>
</xsd:schema>
