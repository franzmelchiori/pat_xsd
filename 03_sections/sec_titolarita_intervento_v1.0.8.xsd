<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:etitpos="../02_entities/titolo_possesso"
    xmlns:stitint="../03_sections/titolarita_intervento"
    targetNamespace="../03_sections/titolarita_intervento"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>
    <xsd:import namespace="../02_entities/titolo_possesso" schemaLocation="../02_entities/ent_titolo_possesso_v1.0.8.xsd"/>

    <xsd:complexType name="sezione_titolarita_intervento_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Titolarità dell'intervento</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="titolarita_intervento" type="etitpos:titolo_possesso_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Titolarità dell'intervento</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="sezione_titolarita_sanatoria_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Titolarità dell'intervento (permesso di costruire in sanatoria e provvedimento in sanatoria)</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="titolarita_intervento" type="etitpos:titolo_possesso_sanatoria_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Titolarità dell'intervento</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="sezione_titolarita_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Titolarità dell'intervento (segnalazione certificata di agibilità)</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="titolarita_intervento" type="etitpos:titolarita_agibilita_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Titolarità dell'intervento</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="sezione_pat_titolarita_intervento" type="stitint:sezione_titolarita_intervento_ctype"/>
</xsd:schema>
