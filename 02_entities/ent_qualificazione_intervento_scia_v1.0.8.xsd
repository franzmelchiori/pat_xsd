<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:eattass="../02_entities/atto_assenso"
    xmlns:equaintscia="../02_entities/qualificazione_intervento_scia"
    targetNamespace="../02_entities/qualificazione_intervento_scia"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>
    <xsd:import namespace="../02_entities/atto_assenso" schemaLocation="../02_entities/ent_atto_assenso_v1.0.8.xsd"/>

    <xsd:complexType name="impianti_rinnovabili_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">ai sensi dell'art. 5 della legge provinciale del 2 maggio 2022, n. 4: l'installazione di impianti di produzione di energia da fonti rinnovabili</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="data_inizio_lavori" type="ctipi:ggmmaaaa_stype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">i cui lavori inizieranno in data</xsd:documentation>
                    <xsd:documentation xml:lang="it">i lavori non possono iniziare prima di 30 giorni dalla data di presentazione della presente Segnalazione Certificata di Inizio Attività, ai sensi del comma 2 dell'art. 5 della Legge Provinciale 2 maggio 2022 n. 4</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="qualificazione_intervento_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Qualificazione dell'intervento</xsd:documentation>
            <xsd:documentation xml:lang="it">La presente segnalazione relativa all'intervento, descritto nella relazione di asseverazione, riguarda l'inizio dell'attività edilizia</xsd:documentation>
        </xsd:annotation>
        <xsd:choice minOccurs="1" maxOccurs="1">
            <xsd:element name="art_85" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">ai sensi dell'art. 85 della legge provinciale del 4 agosto 2015, n. 15</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="variante_ordinaria" type="eattass:estremi_provvedimento_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">come variante ordinaria al permesso di costruire/SCIA (numero e data)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="variante_in_corso_opera" type="eattass:estremi_provvedimento_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">come variante in corso d'opera al permesso di costruire/SCIA (numero e data)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="completamento_art_85" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">ai sensi dell'art. 85, comma 1, lettera i) della legge provinciale del 4 agosto 2015, n. 15, per la realizzazione della parte di intervento non ultimata</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="alternativa_pdc_art_85" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">ai sensi dell'art. 85, comma 2 della legge provinciale del 4 agosto 2015, n. 15, per gli interventi in alternativa al permesso di costruire</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="impianti_rinnovabili" type="equaintscia:impianti_rinnovabili_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="qualificazione_intervento_scia" type="equaintscia:qualificazione_intervento_ctype"/>
</xsd:schema>
