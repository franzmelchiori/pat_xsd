<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:ecalconcoscila="../02_entities/calcolo_contributo_costruzione_cila"
    targetNamespace="../02_entities/calcolo_contributo_costruzione_cila"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>

    <xsd:complexType name="calcolo_contributo_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Contributo di costruzione</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento da realizzare</xsd:documentation>
        </xsd:annotation>
        <xsd:choice minOccurs="1" maxOccurs="1">
            <xsd:element name="titolo_gratuito" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">è a titolo gratuito</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="titolo_oneroso" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">è a titolo oneroso, in quanto comporta aumento del carico urbanistico che pertanto richiede il calcolo del contributo di costruzione</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="calcolo_contributo_costruzione_cila" type="ecalconcoscila:calcolo_contributo_ctype"/>
</xsd:schema>
