<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:elibfon="../02_entities/libro_fondiario"
    targetNamespace="../02_entities/libro_fondiario"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>

    <xsd:complexType name="libro_fondiario_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Dichiarazioni aggiuntive relativamente al Libro Fondiario</xsd:documentation>
        </xsd:annotation>
        <xsd:choice minOccurs="1" maxOccurs="1">
            <xsd:element name="non_sussistono_vincoli" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non sussistono vincoli iscritti che creano impedimento al rilascio del titolo abilitativo edilizio e alla realizzazione dell'intervento richiesto</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="sussistono_vincoli" type="xsd:string" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sussistono i seguenti vincoli</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="libro_fondiario" type="elibfon:libro_fondiario_ctype"/>
</xsd:schema>
