<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:eattass="../02_entities/atto_assenso"
    xmlns:eassagi="../02_entities/asseverazione_agibilita"
    targetNamespace="../02_entities/asseverazione_agibilita"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>
    <xsd:import namespace="../02_entities/atto_assenso" schemaLocation="../02_entities/ent_atto_assenso_v1.0.8.xsd"/>

    <xsd:complexType name="agibilita_parziale_edifici_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">l'agibilità parziale relativa a singoli edifici o singole porzioni della costruzione, come puntualmente individuati nell'elaborato planimetrico allegato alla dichiarazione di ultimazione lavori in quanto</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="funzionalmente_autonomi" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">i singoli edifici o singole porzioni della costruzione sono funzionalmente autonomi</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="urbanizzazione_primaria" type="xsd:boolean" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono state realizzate e collaudate le eventuali opere di urbanizzazione primaria relative all'intero intervento edilizio</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="convenzione_urbanizzazione" type="eattass:estremi_provvedimento_ctype" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">convenzione per le opere di urbanizzazione primaria (numero e data)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="parti_strutturali" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono state completate e collaudate le parti strutturali connesse alle opere di urbanizzazione</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="impianti_parti_comuni" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono stati collaudati e certificati gli impianti relativi alle parti comuni</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="agibilita_parziale_unita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">l'agibilità parziale relativa a singole unità immobiliari (U.I.), come puntualmente individuate nell'elaborato planimetrico allegato alla dichiarazione di ultimazione lavori, in quanto</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="unita_completate" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">le singole unità immobiliari sono completate</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="opere_strutturali" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono completate e collaudate le opere strutturali connesse</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="impianti_certificati" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono certificati gli impianti</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="parti_comuni" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono completate le parti comuni</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="urbanizzazione_primaria" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">sono completate le opere di urbanizzazione primaria dichiarate funzionali rispetto all'edificio oggetto di agibilità parziale</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="convenzione_urbanizzazione" type="eattass:estremi_provvedimento_ctype" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">previste dalla convenzione (numero e data)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="assevera_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Assevera</xsd:documentation>
            <xsd:documentation xml:lang="it">L'agibilità è da intendersi parziale qualora non siano stati completati tutti i lavori contemplati dai titoli edilizi di cui alle dichiarazioni precedenti</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="agibilita_totale" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">l'agibilità relativa a tutti i lavori contemplati dai titoli edilizi di cui alle dichiarazioni precedenti</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="agibilita_parziale_edifici" type="eassagi:agibilita_parziale_edifici_ctype" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="agibilita_parziale_unita" type="eassagi:agibilita_parziale_unita_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="sicurezza_impianti_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Sicurezza degli impianti</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="non_interessa_impianti" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non ha interessato gli impianti</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="interessa_impianti" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">ha interessato gli impianti dotati della certificazione nel modello "deposito dichiarazione di conformità degli impianti"</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="strutture_interessate_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">ha interessato le strutture dell'edificio e pertanto</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="collaudo_statico" type="eattass:estremi_firmatario_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">si richiama il certificato di collaudo statico allegato alla dichiarazione di ultimazione lavori (numero, data e firmatario)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="interventi_strutturali_minori" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non si è proceduto al collaudo statico trattandosi di interventi strutturali minori non soggetti ad obbligo di collaudo (p.to 8.4.3 d.m. 17 gennaio 2018 recante "Aggiornamento delle norme tecniche per le costruzioni")</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="sicurezza_statica_sismica_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Sicurezza statica e sismica</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="non_interessa_strutture" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non ha interessato le strutture dell'edificio</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="interessa_strutture" type="eassagi:strutture_interessate_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="prestazione_energetica_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Prestazione energetica degli edifici</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="non_soggetto_ape" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non è soggetto al rilascio dell'attestato di prestazione energetica</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="soggetto_ape" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">è soggetto al rilascio dell'attestato di prestazione energetica e pertanto si comunica di aver depositato con la dichiarazione di ultimazione lavori l'attestato di prestazione energetica dell'edificio o dell'unità immobiliare</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="barriere_architettoniche_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Barriere architettoniche</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento, con riferimento al d.P.R. n. 380/2001 e al d.m. 14 giugno 1989, n. 236 o della corrispondente normativa Provinciale L.P. 7 gennaio 1991, n. 1</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="non_soggetto_barriere" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non è soggetto alle prescrizioni sull'abbattimento delle barriere architettoniche</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="soggetto_barriere_conforme" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">è soggetto alle prescrizioni sull'abbattimento delle barriere architettoniche e le opere realizzate sono conformi alla normativa in materia di superamento delle barriere architettoniche</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="conformita_igienico_sanitaria_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Conformità igienico sanitaria - reti tecnologiche</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="conforme_requisiti" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">che l'intervento è conforme ai requisiti igienico-sanitari previsti dalla normativa vigente e ricade nelle ipotesi di cui all'articolo 24, commi 5 bis e 5 ter, del decreto del Presidente della Repubblica n. 380 del 2001</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:choice minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">i lavori realizzati</xsd:documentation>
                </xsd:annotation>
                <xsd:element name="allega_attestazione_gestore" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="it">necessitano e quindi si allega (solo se l'Ente Gestore è diverso dal Comune) attestazione della regolarità dell'impianto fognario da parte del Gestore delle reti di fognatura comunale</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="attestazione_comune_gestore" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="it">necessitano e l'Ente Gestore è il Comune che ha rilasciato l'attestazione della regolarità dell'impianto fognario</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                <xsd:element name="non_necessaria_attestazione" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="it">non necessitano dell'attestazione della regolarità dell'impianto fognario</xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
            </xsd:choice>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="prevenzione_incendi_soggetto_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">è soggetto ad adempimenti specifici in materia di prevenzione incendi, e pertanto</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="autorizzazione_provvisoria" type="eattass:estremi_firmatario_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">si richiama la dichiarazione che costituisce autorizzazione provvisoria all'esercizio dell'attività allegato alla dichiarazione di ultimazione lavori (numero, data e firmatario)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="certificato_prevenzione_incendi" type="eattass:estremi_firmatario_ctype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">si richiama il certificato di prevenzione incendi allegato alla dichiarazione di ultimazione lavori (numero, data e firmatario)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:complexType name="sicurezza_antincendio_agibilita_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Sicurezza antincendio</xsd:documentation>
            <xsd:documentation xml:lang="it">che l'intervento</xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="non_soggetto_prevenzione_incendi" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non è soggetto ad adempimenti specifici in materia di prevenzione incendi</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="soggetto_prevenzione_incendi" type="eassagi:prevenzione_incendi_soggetto_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="asseverazione_agibilita" type="eassagi:assevera_agibilita_ctype"/>
</xsd:schema>
