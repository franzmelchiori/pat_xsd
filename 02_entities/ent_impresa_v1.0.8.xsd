<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:epeindita="../02_entities/indirizzo_italiano"
    xmlns:epeiscrea="../02_entities/iscrizione_REA"
    xmlns:eimpresa="../02_entities/impresa"
    targetNamespace="../02_entities/impresa"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>
    <xsd:import namespace="../02_entities/indirizzo_italiano" schemaLocation="../02_entities/ent_indirizzo_italiano_v1.0.8.xsd"/>
    <xsd:import namespace="../02_entities/iscrizione_REA" schemaLocation="../02_entities/ent_iscrizione_REA_v1.0.7.xsd"/>

    <!-- un'impresa può avere il solo codice fiscale numerico, con la sintassi della partita IVA -->
    <xsd:simpleType name="codice_fiscale_impresa_stype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Codice fiscale della persona fisica o codice fiscale numerico dell'impresa</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="([A-Z]{6}[0-9LMNPQRSTUV]{2}[ABCDEHLMPRST][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z])|([0-9]{11})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="opzione_ditta_rea_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">Ditta CCIAA iscritta al REA</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="rea" type="epeiscrea:iscrizione_REA_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:group name="dati_impresa_group">
        <xsd:sequence>
            <xsd:element name="codice_fiscale" type="eimpresa:codice_fiscale_impresa_stype" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="partita_iva" type="ctipi:partita_iva_stype" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="indirizzo_attivita" type="epeindita:indirizzo_italiano_ctype" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="telefono_cellulare" type="ctipi:telefono_mobile_stype" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="email" type="ctipi:email_stype" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">PEC/email</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:group>

    <xsd:complexType name="impresa_ctype">
        <xsd:sequence>
            <xsd:element name="denominazione" type="xsd:string" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="forma_giuridica" type="ccodelist:CodeType" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:appinfo>
                        <canncl:codeListReference>
                            <canncl:codeListID_cl>IT:SUAP:CL:FormeGiuridiche</canncl:codeListID_cl>
                        </canncl:codeListReference>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:group ref="eimpresa:dati_impresa_group"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- impresa esecutrice: il PDF PAT chiede denominazione, codice fiscale o partita IVA e sede legale, senza la forma giuridica -->
    <xsd:complexType name="impresa_forma_giuridica_facoltativa_ctype">
        <xsd:sequence>
            <xsd:element name="denominazione" type="xsd:string" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="forma_giuridica" type="ccodelist:CodeType" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:appinfo>
                        <canncl:codeListReference>
                            <canncl:codeListID_cl>IT:SUAP:CL:FormeGiuridiche</canncl:codeListID_cl>
                        </canncl:codeListReference>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:group ref="eimpresa:dati_impresa_group"/>
        </xsd:sequence>
    </xsd:complexType>
    
    <xsd:element name="entita_pat_impresa" type="eimpresa:impresa_ctype"/>
</xsd:schema>
