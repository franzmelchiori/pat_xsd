<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:eprocontcos="../02_entities/prospetto_contributo_costruzione"
    targetNamespace="../02_entities/prospetto_contributo_costruzione"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>

    <xsd:complexType name="contributo_costruzione_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Contributo di costruzione (relazione tecnica di asseverazione)</xsd:documentation>
        </xsd:annotation>
        <xsd:choice minOccurs="1" maxOccurs="1">
            <xsd:element name="non_soggetto" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">non è soggetto in quanto non comporta aumento del carico urbanistico</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="soggetto_allega_prospetto" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">è soggetto e si allega il prospetto di calcolo preventivo del contributo di costruzione a firma di tecnico abilitato</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="prospetto_contributo_costruzione" type="eprocontcos:contributo_costruzione_ctype"/>
</xsd:schema>
