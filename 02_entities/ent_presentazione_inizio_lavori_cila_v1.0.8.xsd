<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ccodelist="../commons/codelist"
    xmlns:cdichiara="../commons/dichiarazioni"
    xmlns:ctipi="../commons/tipi"
    xmlns:canncl="../commons/xsdAnnotations"
    xmlns:epreinilavcila="../02_entities/presentazione_inizio_lavori_cila"
    targetNamespace="../02_entities/presentazione_inizio_lavori_cila"
    elementFormDefault="qualified"
    attributeFormDefault="qualified"
    version="1.0.8"
    xml:lang="it">

    <xsd:import namespace="../commons/codelist" schemaLocation="../commons-codelist.xsd"/>
    <xsd:import namespace="../commons/dichiarazioni" schemaLocation="../commons-dichiarazioni.xsd"/>
    <xsd:import namespace="../commons/tipi" schemaLocation="../commons-tipi.xsd"/>
    <xsd:import namespace="../commons/xsdAnnotations" schemaLocation="../commons-xsd-annotations.xsd"/>

    <xsd:complexType name="atto_rilasciato_ctype">
        <xsd:sequence>
            <xsd:element name="ente" type="ctipi:stringa_standard_stype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Ente</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="protocollo" type="ctipi:stringa_standard_stype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Numero di protocollo</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="data_domanda" type="ctipi:ggmmaaaa_stype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Data della domanda</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="data_rilascio" type="ctipi:ggmmaaaa_stype" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">Data del rilascio</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="atti_rilasciati_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">per la cui realizzazione sono necessari altri atti di assenso, già rilasciati dalle competenti amministrazioni e di seguito elencati</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="atto" type="epreinilavcila:atto_rilasciato_ctype" minOccurs="1" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="presentazione_inizio_lavori_ctype">
        <xsd:annotation>
            <xsd:documentation xml:lang="it">PAT Presentazione della comunicazione di inizio dei lavori asseverata</xsd:documentation>
            <xsd:documentation xml:lang="it">Si comunica l'inizio dei lavori per interventi</xsd:documentation>
        </xsd:annotation>
        <xsd:choice minOccurs="1" maxOccurs="1">
            <xsd:element name="no_altri_atti" type="xsd:boolean" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation xml:lang="it">per la cui realizzazione non sono necessari altri atti di assenso (ad es. autorizzazione paesaggistica, ecc.)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="atti_rilasciati" type="epreinilavcila:atti_rilasciati_ctype" minOccurs="1" maxOccurs="1"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="presentazione_inizio_lavori_cila" type="epreinilavcila:presentazione_inizio_lavori_ctype"/>
</xsd:schema>
